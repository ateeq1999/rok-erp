# Read by `pharmacy` and `migration-verifier` at startup: each looks for
# `.env` in the working directory and then its parents, and a name already set
# in the environment wins over the file. Copy this to `.env` and edit it.

# --- read by this workspace -----------------------------------------------

# The server every command and test connects to.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/pharmacy_db

# Tracing filter for the app.
RUST_LOG=info,sqlx=warn

# Where the module installer reads its manifests from. Defaults to this
# repository's database/modules, so it is normally left unset.
#ROK_MODULES_DIR=./database/modules

# Where `pharmacy --install` reads the story seed from. Defaults to
# database/seeds/afya_pharmacy_story.sql, so it is normally left unset.
#ROK_STORY_SEED=./database/seeds/afya_pharmacy_story.sql

# --- reserved for the service stack ---------------------------------------

HOST=127.0.0.1
PORT=8080
DATABASE_MAX_CONNECTIONS=10
JWT_SECRET=dev-only-secret-do-not-use-in-production-32chars-min
JWT_EXPIRY_SECONDS=3600
ALLOWED_ORIGINS=
PUBLIC_BASE_URL=http://127.0.0.1:8080
STORAGE_DRIVER=s3
AWS_S3_ENDPOINT=http://127.0.0.1:4566
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET=rok-erp-avatars
AWS_S3_ACCESS_KEY=test
AWS_S3_SECRET_KEY=test
LOCAL_STORAGE_ROOT=./var/storage
MAIL_DRIVER=mailpit
MAIL_FROM=no-reply@rok-erp.test
MAILPIT_HOST=127.0.0.1
MAILPIT_PORT=1025

AWS_SES_ENDPOINT=http://127.0.0.1:4566
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY=test
AWS_SES_SECRET_KEY=test
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
