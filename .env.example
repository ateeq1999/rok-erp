MAILPIT_PORT=1025

AWS_SES_ENDPOINT=http://127.0.0.1:4566
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY=test
AWS_SES_SECRET_KEY=test
RESEND_API_KEY=
RUST_LOG=info,sqlx=warn

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
